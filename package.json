{
  "name": "tradebo-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests/atlas.test.ts tests/browser playwright.config.ts vite.config.ts index.html README.md",
    "format:check": "prettier --check src tests/atlas.test.ts tests/browser playwright.config.ts vite.config.ts index.html README.md",
    "test": "tsx --test tests/atlas.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
